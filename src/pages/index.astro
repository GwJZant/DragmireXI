---
// src/pages/index.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { YouTube } from 'astro-embed';

const latestVideoId = "105rkm_ll9g";
---
<BaseLayout title="DragmireXI | Home">
    <h1 class="hero-title">DragmireXI</h1>
    <p>Zelda Lore | Projects | Gaming Reviews</p>
    
    <hr />

    <div class="site-description">
        <p>
            Welcome to the domain of DragmireXI. This site is just a personal project of mine so 
            I will post about things I care about, mostly relating to video games. 
			The Legend of Zelda and Final Fantasy XI are my main activities that I would post content for.
        </p>
        <p>
            Currently, I have a few pages already set up. The "Zelda" page contains external theories, assets, and useful resources.
			The "Theory Blog" page is where I post theory documents I have personally written.
			The "Timeline Lab" page has a tool for creating your own Zelda Timeline using the mainline games + Hyrule Warriors games.
			If you think any of these pages need new functionality or you would like a new page added, please contact me (Email in the "About" page).
        </p>
		<p>
			Please stay tuned for more.
		</p>
    </div>
    
    <div class="video-section">
        <h2 class="hero-title">Featured Video</h2>
        <YouTube id={latestVideoId} />
    </div>

    <div class="socials">
        <a href="https://www.youtube.com/@DragmireXI" class="yt-button">Visit Channel</a>
    </div>
</BaseLayout>

<style>
    .hero-title {
        background: linear-gradient(to bottom, var(--ganon-red), var(--power-gold));
        background-clip: text;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(2px 2px 5px var(--malice-purple));
    }
    .video-section {
        margin: 3rem auto;
        max-width: 720px;
    }
    .goals-container {
        display: flex;
        justify-content: center;
        margin-top: 1.5rem;
    }

    .goals-list {
        text-align: left;
        display: inline-block;
        line-height: 1.8;
    }

    .goals-list li {
        margin-bottom: 0.5rem;
        padding-left: 0.5rem;
    }
</style>